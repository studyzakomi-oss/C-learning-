{
  "name": "c-quest",
  "private": true,
  "version": "1.0.0",
  "description": "C Quest — L'Académie du Code : jeu éducatif pour apprendre le langage C en français",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:content": "node scripts/verify-content.mjs",
    "verify:gcc": "node scripts/diff-gcc.mjs",
    "e2e": "vite build && node scripts/e2e.mjs",
    "icons": "node scripts/make-icons.mjs",
    "android:sync": "vite build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@preact/preset-vite": "^2.10.6",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
